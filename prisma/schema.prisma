generator client {
  provider      = "prisma-client-js"
  output        = "../node_modules/.prisma/client"
  binaryTargets = ["native", "rhel-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Category {
  id             String         @id @default(uuid())
  name           String         @unique
  icon           String
  color          String
  status         CategoryStatus
  seoTitle       String         @unique
  seoDescription String
  createdAt      DateTime       @default(now())
  products       Product[]

  @@index([status])
  @@index([createdAt])
}

model Product {
  id                 String     @id @default(uuid())
  name               String
  slug               String     @unique
  description        String
  price              Float
  imageUrls          String[]
  stockQuantity      Int
  maxQuantityPerUser Int        @default(5)
  isActive           Boolean    @default(true)
  category           Category   @relation(fields: [categoryID], references: [id])
  categoryID         String
  cartItems          CartItem[]
  reviews            Review[] // Added opposite relation field for Review
  createdAt          DateTime   @default(now())
  updatedAt          DateTime?  @updatedAt

  @@index([isActive])
  @@index([price])
  @@index([createdAt])
}

model Order {
  id                 String      @id @default(uuid())
  customerName       String
  customerEmail      String
  customerPhone      String
  shippingStreet     String
  shippingCity       String
  shippingZipCode    String?
  items              OrderItem[]
  subtotal           Float
  shippingCost       Float
  discount           Float
  finalAmount        Float
  paymentMethod      String
  status             OrderStatus @default(pending)
  trackingNumber     String?
  shippingCompanyURL String?
  notes              String?
  createdAt          DateTime    @default(now())
  updatedAt          DateTime?   @updatedAt

  userId String
  user   User   @relation(fields: [userId], references: [id])

  couponId   String?
  coupon     Coupon? @relation(fields: [couponId], references: [id], onDelete: SetNull)
  couponCode String?

  couponUsages CouponUsage[]

  @@index([userId])
  @@index([status])
  @@index([createdAt])
}

model OrderItem {
  id          String @id @default(uuid())
  order       Order  @relation(fields: [orderId], references: [id])
  orderId     String
  productId   String
  productName String
  quantity    Int
  price       Float
  total       Float

  @@index([orderId])
  @@index([productId])
}

model Review {
  id          String       @id @default(uuid())
  productId   String
  productName String
  userId      String
  userName    String
  rating      Int
  comment     String
  status      ReviewStatus @default(pending)
  reason      String?      
  createdAt   DateTime     @default(now())

  product Product @relation(fields: [productId], references: [id]) // Added relationship to Product

  @@index([productId])
  @@index([userId])
  @@index([status])
}

model User {
  id     String   @id @default(uuid())
  name   String
  email  String?  @unique
  role   UserRole @default(user)
  cart   Cart? // One-to-one relation
  orders Order[] // One-to-many relation

  couponUsages CouponUsage[]
}

model Cart {
  id        String     @id @default(uuid())
  userId    String     @unique
  user      User       @relation(fields: [userId], references: [id])
  items     CartItem[]
  createdAt DateTime   @default(now())
  updatedAt DateTime?  @updatedAt

  @@index([userId])
  @@index([createdAt])
}

model CartItem {
  id        String  @id @default(uuid())
  cart      Cart    @relation(fields: [cartId], references: [id])
  cartId    String
  product   Product @relation(fields: [productId], references: [id])
  productId String
  name      String
  price     Float
  imageUrl  String
  quantity  Int

  @@index([cartId])
  @@index([productId])
}

model Coupon {
  id                String     @id @default(uuid()) @map("coupon_id")
  code              String     @unique
  description       String?    @db.Text
  type              CouponType
  value             Decimal    @db.Decimal(10, 2)
  isActive          Boolean    @default(true) @map("is_active")
  maxUsageCount     Int?       @map("max_usage_count")
  perUserUsageCount Int?       @map("per_user_usage_count")
  maxDiscountAmount Decimal?   @map("max_discount_amount") @db.Decimal(10, 2)
  minCartAmount     Decimal?   @default(0.00) @map("min_cart_amount") @db.Decimal(10, 2)
  startDate         DateTime   @map("start_date")
  expirationDate    DateTime   @map("expiration_date")
  createdAt         DateTime   @default(now()) @map("created_at")

  orders Order[]

  usages CouponUsage[]

  @@index([isActive])
  @@index([startDate])
  @@index([expirationDate])
  @@map("coupons")
}

model CouponUsage {
  usageId Int @id @default(autoincrement()) @map("usage_id")

  couponId String @map("coupon_id")
  coupon   Coupon @relation(fields: [couponId], references: [id], onDelete: Cascade)

  userId String @map("user_id")
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  orderId String @map("order_id")
  order   Order  @relation(fields: [orderId], references: [id], onDelete: Cascade)

  appliedAt DateTime @default(now()) @map("applied_at")

  @@unique([couponId, userId, orderId]) // prevent duplicate application entries
  @@index([couponId])
  @@index([userId])
  @@index([orderId])
  @@map("coupon_usages")
}

enum CouponType {
  percentage
  fixed
  free_shipping
}

enum CategoryStatus {
  active
  inactive
}

enum OrderStatus {
  pending
  processing
  shipped
  delivered
  cancelled
}

enum ReviewStatus {
  pending
  approved
  rejected
}

enum UserRole {
  user
  admin
}
