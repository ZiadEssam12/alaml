generator client {
  provider = "prisma-client"
  output   = "../src/app/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model Category {
  id             String         @id @default(uuid())
  name           String         @unique
  icon           String
  color          String
  status         CategoryStatus
  seoTitle       String         @unique
  seoDescription String
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @default(now()) @updatedAt
  products       Product[]
  offers         Offer[]

  @@index([status])
  @@index([createdAt])
}

model Product {
  id                 String           @id @default(uuid())
  name               String
  slug               String           @unique
  description        String
  price              Float
  imageUrls          String[]
  stockQuantity      Int
  maxQuantityPerUser Int              @default(5)
  categoryID         String
  isActive           Boolean          @default(true)
  createdAt          DateTime         @default(now())
  updatedAt          DateTime?        @updatedAt
  averageRating      Float            @default(0)
  ratingCount        Int              @default(0)
  ratingSum          Int              @default(0)
  keywords           String[]         @default([])
  cartItems          CartItem[]
  category           Category         @relation(fields: [categoryID], references: [id])
  options            ProductOption[]
  variants           ProductVariant[]
  reviews            Review[]
  offers             Offer[]

  @@index([isActive])
  @@index([price])
  @@index([createdAt])
  @@index([averageRating])
}

/// Product option dimensions per product (e.g., Size, Color)
model ProductOption {
  id             String                 @id @default(uuid())
  productId      String
  name           String
  presentation   String?
  position       Int                    @default(0)
  createdAt      DateTime               @default(now())
  updatedAt      DateTime               @updatedAt
  product        Product                @relation(fields: [productId], references: [id], onDelete: Cascade)
  values         ProductOptionValue[]
  variantOptions ProductVariantOption[]

  @@unique([productId, name])
}

/// Allowed values for a given product option (e.g., Size: S/M/L)
model ProductOptionValue {
  id             String                 @id @default(uuid())
  optionId       String
  value          String
  hex            String?
  imageUrl       String?
  position       Int                    @default(0)
  createdAt      DateTime               @default(now())
  updatedAt      DateTime               @updatedAt
  option         ProductOption          @relation(fields: [optionId], references: [id], onDelete: Cascade)
  variantOptions ProductVariantOption[]

  @@unique([optionId, value])
}

/// A concrete sellable combination of option values with its own price/stock
model ProductVariant {
  id              String                 @id @default(uuid())
  productId       String
  sku             String?                @unique
  price           Decimal                @db.Decimal(10, 2)
  stockQuantity   Int                    @default(0)
  isActive        Boolean                @default(true)
  imageUrls       String[]
  combinationHash String                 @unique
  createdAt       DateTime               @default(now())
  updatedAt       DateTime               @updatedAt
  cartItems       CartItem[]
  product         Product                @relation(fields: [productId], references: [id], onDelete: Cascade)
  options         ProductVariantOption[]

  @@index([productId])
}

/// Join table linking a variant to the chosen value for each option
model ProductVariantOption {
  id        String             @id @default(uuid())
  variantId String
  optionId  String
  valueId   String
  option    ProductOption      @relation(fields: [optionId], references: [id], onDelete: Cascade)
  value     ProductOptionValue @relation(fields: [valueId], references: [id], onDelete: Cascade)
  variant   ProductVariant     @relation(fields: [variantId], references: [id], onDelete: Cascade)

  @@unique([variantId, optionId])
}

model Order {
  id                 String        @id @default(uuid())
  customerName       String
  customerEmail      String
  customerPhone      String
  shippingStreet     String
  subtotal           Float
  shippingCost       Float
  discount           Float
  finalAmount        Float
  paymentMethod      String
  status             OrderStatus   @default(pending)
  trackingNumber     String?
  shippingCompanyURL String?
  notes              String?
  createdAt          DateTime      @default(now())
  updatedAt          DateTime?     @updatedAt
  userId             String
  couponCode         String?
  couponId           String?
  coupon             Coupon?       @relation(fields: [couponId], references: [id])
  user               User          @relation(fields: [userId], references: [id])
  items              OrderItem[]
  couponUsages       CouponUsage[]
  offerUsages        OfferUsage[]

  @@index([userId])
  @@index([status])
  @@index([createdAt])
}

model OrderItem {
  id          String @id @default(uuid())
  orderId     String
  productId   String
  productName String
  quantity    Int
  price       Float
  total       Float
  order       Order  @relation(fields: [orderId], references: [id])

  @@index([orderId])
  @@index([productId])
}

model Review {
  id          String       @id @default(uuid())
  productId   String
  productName String
  userId      String
  userName    String
  rating      Int
  comment     String
  status      ReviewStatus @default(pending)
  createdAt   DateTime     @default(now())
  reason      String?
  product     Product      @relation(fields: [productId], references: [id])

  @@index([productId])
  @@index([userId])
  @@index([status])
}

model User {
  id           String        @id @default(uuid())
  name         String
  email        String?       @unique
  role         UserRole      @default(user)
  cart         Cart?
  CustomOrder  CustomOrder[]
  orders       Order[]
  couponUsages CouponUsage[]
  offerUsages  OfferUsage[]
}

model Cart {
  id        String     @id @default(uuid())
  userId    String     @unique
  createdAt DateTime   @default(now())
  updatedAt DateTime?  @updatedAt
  user      User       @relation(fields: [userId], references: [id])
  items     CartItem[]

  @@index([userId])
  @@index([createdAt])
}

model CartItem {
  id             String          @id @default(uuid())
  cartId         String
  productId      String
  name           String
  price          Float
  imageUrl       String
  quantity       Int
  variantId      String?
  variantOptions String?
  cart           Cart            @relation(fields: [cartId], references: [id])
  product        Product         @relation(fields: [productId], references: [id])
  variant        ProductVariant? @relation(fields: [variantId], references: [id])

  @@index([cartId])
  @@index([productId])
  @@index([variantId])
}

model Offer {
  id                String       @id @default(uuid()) @map("offer_id")
  title             String
  description       String?
  scope             OfferScope
  productId         String?
  categoryId        String?
  type              CouponType
  value             Decimal      @db.Decimal(10, 2)
  isActive          Boolean      @default(true) @map("is_active")
  isAutoApply       Boolean      @default(true) @map("is_auto_apply")
  code              String?      @unique
  maxUsageCount     Int?         @map("max_usage_count")
  perUserUsageCount Int?         @map("per_user_usage_count")
  maxDiscountAmount Decimal?     @map("max_discount_amount") @db.Decimal(10, 2)
  minCartAmount     Decimal?     @default(0.00) @map("min_cart_amount") @db.Decimal(10, 2)
  startDate         DateTime     @map("start_date")
  expirationDate    DateTime     @map("expiration_date")
  createdAt         DateTime     @default(now()) @map("created_at")
  usages            OfferUsage[]
  category          Category?    @relation(fields: [categoryId], references: [id], onDelete: Cascade)
  product           Product?     @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@index([isActive])
  @@index([scope])
  @@index([productId])
  @@index([categoryId])
  @@index([startDate])
  @@index([expirationDate])
  @@map("offers")
}

model OfferUsage {
  usageId   Int      @id @default(autoincrement()) @map("usage_id")
  offerId   String   @map("offer_id")
  userId    String   @map("user_id")
  orderId   String   @map("order_id")
  appliedAt DateTime @default(now()) @map("applied_at")
  offer     Offer    @relation(fields: [offerId], references: [id], onDelete: Cascade)
  order     Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([offerId, userId, orderId])
  @@index([offerId])
  @@index([userId])
  @@index([orderId])
  @@map("offer_usages")
}

model Coupon {
  id                String        @id @default(uuid()) @map("coupon_id")
  code              String        @unique
  description       String?
  type              CouponType
  value             Decimal       @db.Decimal(10, 2)
  isActive          Boolean       @default(true) @map("is_active")
  maxUsageCount     Int?          @map("max_usage_count")
  perUserUsageCount Int?          @map("per_user_usage_count")
  startDate         DateTime      @map("start_date")
  expirationDate    DateTime      @map("expiration_date")
  createdAt         DateTime      @default(now()) @map("created_at")
  maxDiscountAmount Decimal?      @map("max_discount_amount") @db.Decimal(10, 2)
  minCartAmount     Decimal?      @default(0.00) @map("min_cart_amount") @db.Decimal(10, 2)
  orders            Order[]
  usages            CouponUsage[]

  @@index([isActive])
  @@index([startDate])
  @@index([expirationDate])
  @@map("coupons")
}

model CouponUsage {
  usageId   Int      @id @default(autoincrement()) @map("usage_id")
  couponId  String   @map("coupon_id")
  userId    String   @map("user_id")
  orderId   String   @map("order_id")
  appliedAt DateTime @default(now()) @map("applied_at")
  coupon    Coupon   @relation(fields: [couponId], references: [id], onDelete: Cascade)
  order     Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([couponId, userId, orderId])
  @@index([couponId])
  @@index([userId])
  @@index([orderId])
  @@map("coupon_usages")
}

model CustomOrder {
  id          String            @id @default(uuid())
  name        String
  email       String
  phone       String
  productType String
  description String
  quantity    Int?
  budget      Float?
  url         String?
  createdAt   DateTime          @default(now())
  status      CustomOrderStatus @default(in_progress)
  updatedAt   DateTime          @updatedAt
  userId      String
  user        User              @relation(fields: [userId], references: [id])

  @@index([status])
  @@index([createdAt])
}

enum OfferScope {
  product
  category
}

enum CouponType {
  percentage
  fixed
  free_shipping
}

enum CategoryStatus {
  active
  inactive
}

enum OrderStatus {
  pending
  processing
  shipped
  delivered
  cancelled
}

enum ReviewStatus {
  pending
  approved
  rejected
}

enum UserRole {
  user
  admin
}

enum CustomOrderStatus {
  in_progress
  done
  refused
}
